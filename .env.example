# Copy to .env.local for local dev, and set the same vars in Vercel → Settings →
# Environment Variables for production. None of these use the NEXT_PUBLIC_ prefix
# because they are SECRETS — they must stay server-only and never reach the browser.

# Public site URL (already set in Vercel). The one exception that IS public.
NEXT_PUBLIC_SITE_URL=https://phatcharadanai.vercel.app

# --- Contact form: email (Resend — https://resend.com) ---
# Create an account, then API Keys → create a key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where contact messages are delivered. In Resend test mode (before you verify a
# domain) this MUST be the email you signed up to Resend with.
CONTACT_TO_EMAIL=phatcharadanai.tangoan@gmail.com
# Optional: only set once you've verified your own domain in Resend.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# --- Contact form: rate limiting (Upstash Redis — https://upstash.com) ---
# Create a free Redis database, then copy the REST URL + token.
# If these are left unset, rate limiting is skipped and the form still works.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
